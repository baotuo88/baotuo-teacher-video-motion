# Generate a secret with: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
ADMIN_PASSWORD=
PORT=8000

# Generate using: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PROVIDER_ENCRYPTION_KEY=
# Set 1 when served over HTTPS
COOKIE_SECURE=0

# Used only by compose.registry.yaml; use your actual lower-case owner/repo
IMAGE=ghcr.io/baotuo88/baotuo-teacher-video-motion:latest

# Resource admission limits (not a billing quota)
MIN_FREE_DISK_MB=1024
MAX_PENDING_JOBS=20

# HTTPS production overlay: DNS must point at this host; open ports 80/443
DOMAIN=studio.example.com
ACME_EMAIL=admin@example.com

# Optional operator-controlled HTTP CONNECT proxy; blank means direct.
# Containers cannot reach the host proxy via 127.0.0.1; use a reachable proxy host.
PROVIDER_HTTP_PROXY=
