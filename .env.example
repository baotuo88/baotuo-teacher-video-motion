# Generate a secret with: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
ADMIN_PASSWORD=
PORT=8000

# Generate using: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PROVIDER_ENCRYPTION_KEY=
# Set 1 when served over HTTPS
COOKIE_SECURE=0

# Used only by compose.registry.yaml; use your actual lower-case owner/repo
IMAGE=ghcr.io/baotuo88/baotuo-teacher-video-motion:latest
